<Window x:Class="WpfApp1.MyDocumentViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MyDocumentViewer" Height="450" Width="800">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top" Height="40" Width="341"  HorizontalAlignment="Left">
            <ToolBar x:Name="FileToolBar" Height="40" Width="200">
                <Button x:Name="NewFileButton" Width="38" Height="38">
                    <Image Height="32" Width="32" Source=""/>
                </Button>
                <Button x:Name="OpenFileButton" Width="38" Height="38">
                    <Image Height="32" Width="32" Source=""/>
                </Button>
                <Button x:Name="SaveFileButton" Width="38" Height="38">
                    <Image Height="32" Width="32" Source=""/>
                </Button>
                <Button x:Name="ClearFileButton" Width="38" Height="38">
                    <Image Height="32" Width="32" Source=""/>
                </Button>
            </ToolBar>
            <ToolBar x:Name="EditingToolBar" Background="#FFFDF0EE">
                <ToggleButton x:Name="BoldButton" Width="38" Height="38">
                    <Image Height="32" Width="32" Source=""/>
                </ToggleButton>
                <ToggleButton x:Name="IButton" Width="38" Height="38">
                    <Image Height="32" Width="32" Source=""/>
                </ToggleButton>
                <ToggleButton x:Name="UButton" Width="38" Height="38">
                    <Image Height="32" Width="32" Source=""/>
                </ToggleButton>
            </ToolBar>
        </ToolBarTray>
        <RichTextBox Background="#FFF9F6E3">
            <FlowDocument>
                
            </FlowDocument>
        </RichTextBox>
    </DockPanel>
</Window>
