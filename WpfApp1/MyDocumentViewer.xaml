<Window x:Class="WpfApp1.MyDocumentViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MyDocumentViewer" Height="450" Width="800">
    <DockPanel x:Name="documentRichTextBox">
        <ToolBarTray DockPanel.Dock="Top" Height="40" Width="800" HorizontalAlignment="Left">
            <ToolBar x:Name="ApplicationToolBar" Height="40" Width="200">
                <Button x:Name="NewFileButton" Width="38" Height="38">
                    <Image Height="32" Width="32" Source="/new.png"/>
                </Button>
                <Button x:Name="OpenFileButton" Width="38" Height="38">
                    <Image Height="32" Width="32" Source="/open.png"/>
                </Button>
                <Button x:Name="SaveFileButton" Width="38" Height="38">
                    <Image Height="32" Width="32" Source="/save.png"/>
                </Button>
                <Button x:Name="ClearFileButton" Width="38" Height="38">
                    <Image Height="32" Width="32" Source="/trash.png"/>
                </Button>
            </ToolBar>
            <ToolBar x:Name="EditingToolBar" Height="40" Width="400" Background="#FFF7EBE5">
                <ToggleButton x:Name="BoldButton" Width="38" Height="38" FontWeight="Bold" FontSize="16">
                    <Image Width="32" Height="32" Source="/bold.png"/>
                </ToggleButton>
                <ToggleButton x:Name="ItalicButton" Width="38" Height="38" FontWeight="Bold" FontSize="16">
                    <Image Width="32" Height="32" Source="/italic.png"/>
                </ToggleButton>
                <ToggleButton x:Name="UnderlineButton" Width="38" Height="38" FontWeight="Bold" FontSize="16">
                    <Image Width="32" Height="32" Source="/underline.png"/>
                </ToggleButton>
                <xctk:ColorPicker x:Name="FontColorPicker" Width="100" Height="32" DisplayColorAndName="True"/>
                <ComboBox x:Name="FontFamilyComboBox" Height="32" Width="100"/>
                <ComboBox x:Name="FontSizeComboBox" Height="32" Width="50" />
            </ToolBar>
        </ToolBarTray>
        <RichTextBox Background="#FFF5F3E1" TextChanged="RichTextBox_TextChanged" />
    </DockPanel>
</Window>
